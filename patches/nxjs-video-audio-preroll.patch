 void nx_media_set_audio_node(nx_media_t *m, nx_audio_node *node,
                              double sample_rate) {
+	// Main-thread operation. Once decoding has started, the worker owns its
+	// stream configuration. An intentionally silent play() cannot be turned
+	// into a racy late attach; callers must attach before play().
+	if (m->thread.joinable())
+		return;
 	m->audio_node = node;
 	m->audio_out_rate = sample_rate;
+	m->thread = std::thread(decode_thread_main, m);
 }
 
 void nx_media_play(nx_media_t *m) {
+	// Explicit playback with no audio sink (e.g. a headless caller) is
+	// permitted. The normal Video binding attaches its node first.
+	if (!m->thread.joinable())
+		m->thread = std::thread(decode_thread_main, m);
 	if (m->playing.load())
 		return;
 	m->clock_anchor = std::chrono::steady_clock::now();
